generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model user {
  id          BigInt    @id(map: "User_pkey")
  name        String    @db.VarChar
  coordinator Boolean   @default(false)
  password    String?
  reserve     reserve[]
  space       space[]
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model reserve {
  id                         BigInt   @id @default(autoincrement())
  student                    BigInt[]
  coordenator                BigInt
  descripition               String?
  start                      DateTime @db.Time(6)
  end                        DateTime @db.Time(6)
  space                      Int?     @db.SmallInt
  status                     Int      @default(0) @db.SmallInt
  user                       user     @relation(fields: [coordenator], references: [id], onDelete: NoAction)
  space_reserve_spaceTospace space?   @relation("reserve_spaceTospace", fields: [space], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model space {
  id                           Int       @id @default(autoincrement()) @db.SmallInt
  name                         String
  opening                      DateTime  @db.Time(6)
  closing                      DateTime  @db.Time(6)
  responsable                  BigInt
  reserve_reserve_spaceTospace reserve[] @relation("reserve_spaceTospace")
  user                         user      @relation(fields: [responsable], references: [id], onDelete: NoAction)
}
